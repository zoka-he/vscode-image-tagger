{
    "compilerOptions": {
        "target": "ES2021",                // 目标 JavaScript 版本
        "module": "CommonJS",               // 使用 CommonJS 模块系统
        "lib": ["ES2021", "DOM"],           // 使用 ES2021 及 DOM API
        "outDir": "./out",                  // 输出目录
        "rootDir": "./src",                 // 源代码目录
        "strict": true,                      // 启用严格模式
        "esModuleInterop": true,             // 允许 ES 模块和 CommonJS 互操作
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src", "webview"],                      // 编译 `src` 目录下的所有文件
    "exclude": ["node_modules", ".vscode", "out"]
}