{
    "name": "image-tagger",
    "displayName": "Image tagger",
    "description": "A VS Code extension for tagging images with text files",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/zoka-he/vscode-image-tagger.git"
    },
    "publisher": "zoka-he",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "imageTagger.open",
                "title": "Open in Image Tagger",
                "category": "Image Tagger"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "imageTagger.open",
                    "when": "resourceType == 'folder' || explorerResourceIsFolder",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc && vite build",
        "watch": "tsc -w",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package",
        "build": "npm run compile && npm run package",
        "install:vsce": "npm install -g @vscode/vsce"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.75.0",
        "eslint": "^8.0.0",
        "typescript": "^5.0.0",
        "vsce": "^2.15.0"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^5.2.1",
        "@vscode/webview-ui-toolkit": "^1.4.0",
        "lodash": "^4.17.21",
        "pug": "^3.0.3",
        "rxjs": "^7.8.2",
        "sass": "^1.85.1",
        "sharp": "^0.33.5",
        "vite": "^6.2.0",
        "vite-plugin-html": "^3.2.2",
        "vue": "^3.5.13"
    }
}
