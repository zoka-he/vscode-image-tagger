{
    "name": "image-tagger",
    "displayName": "Image tagger",
    "description": "A VS Code extension for tagging images with text files",
    "version": "1.0.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/zoka-he/vscode-image-tagger.git"
    },
    "license": "MIT",
    "engines": {
      "vscode": "^1.75.0"
    },
    "categories": ["Other"],
    "activationEvents": [
      "onCommand:imageTagger.open"
    ],
    "main": "./out/extension.js",
    "contributes": {
      "commands": [
        {
          "command": "imageAnnotator.open",
          "title": "Open Image Annotator"
        }
      ],
      "menus": {
        "explorer/context": [
          {
            "command": "imageAnnotator.open",
            "group": "navigation"
          }
        ]
      }
    },
    "scripts": {
      "compile": "tsc",
      "watch": "tsc -w",
      "pretest": "npm run compile",
      "test": "node ./out/test/runTest.js",
      "package": "vsce package",
      "install:vsce": "npm install -g @vscode/vsce"
    },
    "devDependencies": {
      "@types/node": "^18.0.0",
      "@types/vscode": "^1.75.0",
      "typescript": "^5.0.0",
      "eslint": "^8.0.0",
      "vsce": "^2.15.0"
    }
  }
  