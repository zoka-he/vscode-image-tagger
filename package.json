{
    "name": "image-tagger",
    "displayName": "Image tagger",
    "description": "A VS Code extension for tagging images with text files",
    "version": "0.0.1",
    "repository": {
      "type": "git",
      "url": "https://github.com/zoka-he/vscode-image-tagger.git"
    },
    "publisher": "zoka-he",
    "license": "MIT",
    "engines": {
      "vscode": "^1.75.0"
    },
    "categories": ["Other"],
    "activationEvents": [
      "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
      "commands": [
        {
          "command": "imageTagger.open",
          "text": "Image Tagger",
          "alignment": "left",
          "priority": 100
        }
      ]
    },
    "scripts": {
      "compile": "tsc",
      "watch": "tsc -w",
      "pretest": "npm run compile",
      "test": "node ./out/test/runTest.js",
      "package": "vsce package",
      "build": "npm run compile && npm run package",
      "install:vsce": "npm install -g @vscode/vsce"
    },
    "devDependencies": {
      "@types/node": "^18.0.0",
      "@types/vscode": "^1.75.0",
      "typescript": "^5.0.0",
      "eslint": "^8.0.0",
      "vsce": "^2.15.0"
    }
  }
  